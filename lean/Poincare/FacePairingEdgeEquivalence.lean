import Poincare.FacePairingPillow

namespace Poincare

/-!
Occurrence-sensitive edge identifications induced by a list of face gluings.

An edge occurrence is an oriented pair of distinct local vertices in a
particular tetrahedron occurrence. The generated equivalence identifies
orientation reversal and the images of edges contained in glued faces.

This is not yet a computable edge-class enumerator or an arrow-valence bridge.
-/

/-- A local oriented edge *corner* of one tetrahedron occurrence. -/
structure FacePairingLocalEdge (n : Nat) where
  occurrence : Fin n
  first : Fin 4
  second : Fin 4
  distinct : first ≠ second

def FacePairingLocalEdge.reverse {n : Nat}
    (e : FacePairingLocalEdge n) : FacePairingLocalEdge n where
  occurrence := e.occurrence
  first := e.second
  second := e.first
  distinct := e.distinct.symm

/-- One forward identification: the edge is contained in the source
triangle and its two local endpoints map to the target endpoints. -/
def FaceIdentification.RelatesLocalEdges {n : Nat}
    (g : FaceIdentification n)
    (e f : FacePairingLocalEdge n) : Prop :=
  e.occurrence = g.source.occurrence ∧
  f.occurrence = g.target.occurrence ∧
  e.first ≠ g.source.opposite ∧
  e.second ≠ g.source.opposite ∧
  f.first = g.localVertexMap e.first ∧
  f.second = g.localVertexMap e.second

/-- Smallest equivalence relation generated by orientation reversal and
the edge maps induced by the recorded face identifications. -/
inductive FacePairingData.EdgeEquivalent {n : Nat}
    (K : FacePairingData n) :
    FacePairingLocalEdge n → FacePairingLocalEdge n → Prop where
  | refl (e : FacePairingLocalEdge n) : K.EdgeEquivalent e e
  | reverse (e : FacePairingLocalEdge n) :
      K.EdgeEquivalent e e.reverse
  | pair (g : FaceIdentification n) (hg : g ∈ K.identifications)
      {e f : FacePairingLocalEdge n} (h : g.RelatesLocalEdges e f) :
      K.EdgeEquivalent e f
  | symm {e f : FacePairingLocalEdge n} :
      K.EdgeEquivalent e f → K.EdgeEquivalent f e
  | trans {e f h : FacePairingLocalEdge n} :
      K.EdgeEquivalent e f → K.EdgeEquivalent f h →
      K.EdgeEquivalent e h

theorem FacePairingData.edgeEquivalent_equivalence {n : Nat}
    (K : FacePairingData n) : Equivalence K.EdgeEquivalent := by
  refine ⟨?_, ?_, ?_⟩
  · intro e
    exact .refl e
  · intro e f h
    exact .symm h
  · intro e f h hef hfh
    exact .trans hef hfh

/-- The explicit setoid of corners; quotient classes are unoriented edges
of the face-paired complex (not vertex-set edges). -/
def FacePairingData.edgeSetoid {n : Nat}
    (K : FacePairingData n) : Setoid (FacePairingLocalEdge n) :=
  ⟨K.EdgeEquivalent, K.edgeEquivalent_equivalence⟩

end Poincare
