def Poincare.PR199G2.barycentricDualFlagTriangle : {K : Triangulation} →
  {e : Finset ℕ} → BarycentricDualFlag K e → Set (ℕ → ℝ) :=
fun {K} {e} a => flagTriangle (finiteBarycenter e) (finiteBarycenter a.face) (finiteBarycenter a.tet.verts.toFinset)
def Poincare.PR199G2.barycentricEdgeDualCell : Triangulation → Finset ℕ → Set (ℕ → ℝ) :=
fun K e => ⋃ a, barycentricDualFlagTriangle a
def Poincare.PR199G2.barycentricFlagGraphEndpointEquiv : {K : Triangulation} →
  ClosedTriangulationCore K →
    {v x : ℕ} → AmbientEdgeCyclicFan K v x → BarycentricDualFlag K {v, x} ≃ (g : FanUnorderedGraphEdge K v x) × ↥↑g :=
fun {K} hcore {v x} F => barycentricFlagIncidentEquiv.trans (globalTetGraphEndpointEquiv hcore F)
