import Mathlib

/-!
An algebraic presentation of mod-two dual-edge parity under elementary
backtrack and dual-2-cell edits. This does not identify the presentation
with homotopies of the geometric carrier.
-/

namespace Poincare.DualCellParity

universe u v
variable {Face : Type u} {Cell : Type v}

def parity (w : Face → ZMod 2) (p : List Face) : ZMod 2 :=
  (p.map w).sum

theorem parity_append (w : Face → ZMod 2) (p q : List Face) :
    parity w (p ++ q) = parity w p + parity w q := by
  simp [parity, List.map_append, List.sum_append]

private theorem double_zero (a : ZMod 2) : a + a = 0 := by
  have htwo : (2 : ZMod 2) = 0 := by decide
  calc
    a + a = (2 : ZMod 2) * a := by ring
    _ = 0 := by rw [htwo]; ring

/-- Elementary path-homotopy moves in the dual two-skeleton, as a
    purely combinatorial presentation. -/
inductive Edit (boundary : Cell → List Face) :
    List Face → List Face → Prop
  | erasePair (p q : List Face) (f : Face) :
      Edit boundary (p ++ [f, f] ++ q) (p ++ q)
  | insertPair (p q : List Face) (f : Face) :
      Edit boundary (p ++ q) (p ++ [f, f] ++ q)
  | eraseCell (p q : List Face) (e : Cell) :
      Edit boundary (p ++ boundary e ++ q) (p ++ q)
  | insertCell (p q : List Face) (e : Cell) :
      Edit boundary (p ++ q) (p ++ boundary e ++ q)

/-- Mod-two cocycle condition on each abstract dual two-cell. -/
def IsCocycle (w : Face → ZMod 2)
    (boundary : Cell → List Face) : Prop :=
  ∀ e, parity w (boundary e) = 0

theorem parity_invariant_edit
    (w : Face → ZMod 2) (boundary : Cell → List Face)
    (hw : IsCocycle w boundary)
    {p q : List Face} (h : Edit boundary p q) :
    parity w p = parity w q := by
  cases h with
  | erasePair p q f =>
      simp [parity_append, parity, ← add_assoc, double_zero]
  | insertPair p q f =>
      simp [parity_append, parity, ← add_assoc, double_zero]
  | eraseCell p q e =>
      simp [parity_append, hw e, add_assoc]
  | insertCell p q e =>
      simp [parity_append, hw e, add_assoc]

/-- Invariance under any finite sequence of elementary dual two-cell
    relations. The geometric-carrier comparison is a separate obligation. -/
theorem parity_invariant_edits
    (w : Face → ZMod 2) (boundary : Cell → List Face)
    (hw : IsCocycle w boundary)
    {p q : List Face}
    (h : Relation.ReflTransGen (Edit boundary) p q) :
    parity w p = parity w q := by
  exact Relation.ReflTransGen.trans_induction_on
    (motive := fun {p q} _ => parity w p = parity w q)
    h
    (fun _ => rfl)
    (fun hstep => parity_invariant_edit w boundary hw hstep)
    (fun _ _ ih₁ ih₂ => ih₁.trans ih₂)


/-- Algebraic bridge: a primal edge-cycle annihilates every dual cycle
    generated by edge-fan incidence vectors. This does not assume or
    prove that all dual cycles are generated by those vectors. -/
theorem generated_dual_cycle_pairing_zero
    {Edge Face' : Type*} [Fintype Edge] [Fintype Face']
    (inc : Edge → Face' → ZMod 2)
    (w : Face' → ZMod 2)
    (coeff : Edge → ZMod 2)
    (hw : ∀ e : Edge, (∑ f : Face', inc e f * w f) = 0) :
    (∑ f : Face', w f * (∑ e : Edge, coeff e * inc e f)) = 0 := by
  calc
    (∑ f : Face', w f * (∑ e : Edge, coeff e * inc e f))
        = ∑ f : Face', ∑ e : Edge, coeff e * (inc e f * w f) := by
          apply Finset.sum_congr rfl
          intro f hf
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro e he
          ring
    _ = ∑ e : Edge, ∑ f : Face', coeff e * (inc e f * w f) := by
          rw [Finset.sum_comm]
    _ = ∑ e : Edge, coeff e * (∑ f : Face', inc e f * w f) := by
          apply Finset.sum_congr rfl
          intro e he
          rw [Finset.mul_sum]
    _ = 0 := by simp [hw]


/-- A closed dual cycle has zero parity whenever it is a linear combination
of primal-edge fan incidence vectors. The spanning premise is explicit:
its derivation from simple connectivity remains the global bridge. -/
theorem dual_cycle_pairing_zero_of_edge_fan_span
    {Edge Face' : Type*} [Fintype Edge] [Fintype Face']
    (inc : Edge → Face' → ZMod 2)
    (w : Face' → ZMod 2)
    (z : Face' → ZMod 2)
    (hw : ∀ e : Edge, (∑ f : Face', inc e f * w f) = 0)
    (hspan : ∃ coeff : Edge → ZMod 2,
      ∀ f : Face', z f = ∑ e : Edge, coeff e * inc e f) :
    (∑ f : Face', w f * z f) = 0 := by
  obtain ⟨coeff, hcoeff⟩ := hspan
  simp_rw [hcoeff]
  exact generated_dual_cycle_pairing_zero inc w coeff hw


/-- Finite-dimensional exactness from a boundary-composition identity and
    equality of the ranks of the image and kernel. The rank equality is
    an explicit obligation, not a disguised simple-connectivity proof. -/
theorem range_eq_ker_of_equal_finrank
    {Edge Face' Tet : Type*}
    [AddCommGroup Edge] [Module (ZMod 2) Edge]
    [AddCommGroup Face'] [Module (ZMod 2) Face']
    [AddCommGroup Tet] [Module (ZMod 2) Tet]
    [FiniteDimensional (ZMod 2) Face']
    (edgeToFace : Edge →ₗ[ZMod 2] Face')
    (faceToTet : Face' →ₗ[ZMod 2] Tet)
    (hchain : ∀ x, faceToTet (edgeToFace x) = 0)
    (hrank : Module.finrank (ZMod 2) (↥edgeToFace.range) =
      Module.finrank (ZMod 2) (↥faceToTet.ker)) :
    edgeToFace.range = faceToTet.ker := by
  apply Submodule.eq_of_le_of_finrank_eq
  · rintro z ⟨x, rfl⟩
    exact LinearMap.mem_ker.mpr (hchain x)
  · exact hrank

/-- The exactness theorem produces actual coefficient witnesses for
    any element of the dual boundary kernel. -/
theorem exists_edge_fan_coeff_of_equal_finrank
    {Edge Face' Tet : Type*}
    [AddCommGroup Edge] [Module (ZMod 2) Edge]
    [AddCommGroup Face'] [Module (ZMod 2) Face']
    [AddCommGroup Tet] [Module (ZMod 2) Tet]
    [FiniteDimensional (ZMod 2) Face']
    (edgeToFace : Edge →ₗ[ZMod 2] Face')
    (faceToTet : Face' →ₗ[ZMod 2] Tet)
    (hchain : ∀ x, faceToTet (edgeToFace x) = 0)
    (hrank : Module.finrank (ZMod 2) (↥edgeToFace.range) =
      Module.finrank (ZMod 2) (↥faceToTet.ker))
    (z : Face') (hz : faceToTet z = 0) :
    ∃ coeff : Edge, edgeToFace coeff = z := by
  have hexact := range_eq_ker_of_equal_finrank
    edgeToFace faceToTet hchain hrank
  have hzker : z ∈ faceToTet.ker := LinearMap.mem_ker.mpr hz
  have hzrange : z ∈ edgeToFace.range := by
    rw [hexact]
    exact hzker
  exact hzrange


/-- Pure arithmetic rank bridge: the edge-face rank and dual-cycle
    nullity agree once their genuine finite counts are established.
    The Euler and rank premises still require proof for the actual K. -/
theorem rank_equal_of_closed_three_manifold_counts
    (V E F T rankEdge rankDual : ℕ)
    (hface : F = 2 * T)
    (heuler : V + F = E + T)
    (hprimal : rankEdge + V = E + 1)
    (hdual : rankDual + T = F + 1) :
    rankEdge = rankDual := by
  omega

/-- Rank-count assembly for the abstract finite incidence maps:
    this does NOT derive any counting premise from simple connectivity. -/
theorem edge_fan_exact_of_closed_three_manifold_rank_counts
    {Edge Face' Tet : Type*}
    [AddCommGroup Edge] [Module (ZMod 2) Edge]
    [AddCommGroup Face'] [Module (ZMod 2) Face']
    [AddCommGroup Tet] [Module (ZMod 2) Tet]
    [FiniteDimensional (ZMod 2) Face']
    (edgeToFace : Edge →ₗ[ZMod 2] Face')
    (faceToTet : Face' →ₗ[ZMod 2] Tet)
    (hchain : ∀ x, faceToTet (edgeToFace x) = 0)
    (V E F T : ℕ)
    (hface : F = 2 * T)
    (heuler : V + F = E + T)
    (hprimal :
      Module.finrank (ZMod 2) (↥edgeToFace.range) + V = E + 1)
    (hdual :
      Module.finrank (ZMod 2) (↥faceToTet.ker) + T = F + 1) :
    edgeToFace.range = faceToTet.ker := by
  apply range_eq_ker_of_equal_finrank edgeToFace faceToTet hchain
  exact rank_equal_of_closed_three_manifold_counts V E F T
    _ _ hface heuler hprimal hdual

#print axioms parity_invariant_edit
#print axioms parity_invariant_edits
#print axioms generated_dual_cycle_pairing_zero
#print axioms dual_cycle_pairing_zero_of_edge_fan_span
#print axioms range_eq_ker_of_equal_finrank
#print axioms exists_edge_fan_coeff_of_equal_finrank
#print axioms rank_equal_of_closed_three_manifold_counts
#print axioms edge_fan_exact_of_closed_three_manifold_rank_counts

end Poincare.DualCellParity
